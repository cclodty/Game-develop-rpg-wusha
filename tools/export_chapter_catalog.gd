extends SceneTree
const Cards = preload("res://scripts/card_catalog.gd")
func _initialize() -> void:
	var payload = {"cards": Cards.CARDS, "inners": Cards.INNERS, "presets": Cards.PRESETS, "refinements": Cards.REFINEMENTS}
	var file = FileAccess.open("res://chapter/catalog.js", FileAccess.WRITE)
	if file == null:
		quit(1)
		return
	file.store_string("// Generated by tools/export_chapter_catalog.gd; edit scripts/card_catalog.gd.\n")
	file.store_string("globalThis.WuxiaCatalog = " + JSON.stringify(payload, "  ") + ";\n")
	file.store_string("if (typeof module !== 'undefined') module.exports = globalThis.WuxiaCatalog;\n")
	file.close()
	quit(0)
